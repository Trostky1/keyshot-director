  "narrative": {
    "northStar": "The Scene-First Creative Instrument",
    "overview": "A real KeyShot render anchors a calm workspace. Soft silver surrounds white work surfaces; graphite text and restrained blue actions keep the interface legible without competing with the product image. The page uses system typography, rounded controls, fine dividers and selective ambient depth. This is the current built direction requested in PRODUCT.md, expressed by the later-loaded server/public/director.css.\n\nThe operating hierarchy follows the direction contract in the first body comment of server/public/index.html: see the scene, adjust the look, then refine through conversation. This document records reusable visual rules. The page-specific order and workflow remain in the surface brief.",
    "keyCharacteristics": [
      "The user's actual KeyShot scene carries the visual emphasis.",
      "Silver canvas, white surfaces, graphite type and blue actions.",
      "Rounded controls and panels with quiet borders.",
      "Readable task guidance and distinct focus, disabled and connected states."
    ],
    "rules": [
      {
        "name": "Render Owns the Color",
        "body": "Keep interface color restrained so the user's genuine product render and reference can supply the visual character.",
        "section": "colors"
      },
      {
        "name": "Sentence-Case",
        "body": "Use natural-case labels and short instructions in the active interface; type hierarchy comes from scale and weight.",
        "section": "typography"
      },
      {
        "name": "Scene-First",
        "body": "The live render leads the visual hierarchy; reference matching remains immediately available beside it on desktop and directly after it on mobile.",
        "section": "layout"
      },
      {
        "name": "Selective Depth",
        "body": "Use elevation for the scene and truly overlaid controls; use borders and surface tone for ordinary inspector sections.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the live KeyShot render prominent and unaltered by decorative image substitutes.",
      "Do use silver, white, graphite and restrained blue for the reusable interface.",
      "Do preserve visible focus, useful disabled states and reduced-motion behavior.",
      "Do use rounded surfaces and fine dividers for tool grouping."
    ],
    "donts": [
      "Don't bring back the former square, monochrome workbench as the governing style.",
      "Don't use generated product geometry or imagery in place of real KeyShot evidence.",
      "Don't turn secondary sections into floating shadowed cards."
    ]
  }
